<!DOCTYPE html>
<html>
<head>
    <title>Change Password | HealthSys</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#2563eb">
    <link rel="manifest" href="/manifest.json">
    <link rel="stylesheet" href="/style.css">
    <link rel="stylesheet" href="/ui-modernization.css">
    <script src="/js/dexie.min.js"></script>
    <script src="/js/db.js"></script>
    <script src="/js/offline-access.js"></script>
    <script src="/js/status.js"></script>
    <script src="/js/ui.js" defer></script>
    <script src="/js/sw-register.js"></script>
</head>
<body data-user-id="<%= user.id %>" data-user-name="<%= user.username %>" data-user-role="<%= user.role %>" data-csrf-token="<%= csrfToken %>">
    <main class="auth-container">
        <section class="auth-card">
            <h1>Change Password</h1>
            <p>Signed in as <%= user.username %>.</p>
            <% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
            <% if (success) { %><div class="notice notice-success" role="status"><%= success %></div><% } %>
            <form method="POST" action="/account/password">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-group">
                    <label for="current-password">Current password</label>
                    <div class="password-control">
                        <input id="current-password" class="form-control" type="password" name="current_password" required
                               autocomplete="current-password">
                        <button type="button" class="btn-action" data-password-toggle="current-password"
                                aria-controls="current-password" aria-pressed="false" aria-label="Show password">Show</button>
                    </div>
                </div>
                <div class="form-group">
                    <label for="new-password">New password</label>
                    <div class="password-control">
                        <input id="new-password" class="form-control" type="password" name="new_password" required minlength="12" maxlength="72"
                               autocomplete="new-password">
                        <button type="button" class="btn-action" data-password-toggle="new-password"
                                aria-controls="new-password" aria-pressed="false" aria-label="Show password">Show</button>
                    </div>
                    <small>At least 12 characters, with at least three character types.</small>
                </div>
                <button type="submit" class="btn-primary">Change Password</button>
                <a class="btn-action" href="/dashboard">Cancel</a>
            </form>
        </section>
    </main>
</body>
</html>
